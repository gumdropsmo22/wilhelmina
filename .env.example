# Wilhelmina Discord Bot - Example Environment
# Copy this file to .env and fill in real values.

# Core Discord runtime
DISCORD_TOKEN=
CLIENT_ID=
APP_ENV=development
DEV_GUILD_ID=
LOG_LEVEL=INFO

# Command sync mode:
# - auto: dev guild sync when APP_ENV=development and DEV_GUILD_ID is set; otherwise global sync
# - dev: require DEV_GUILD_ID and sync only that guild
# - global: sync globally
# - off: do not sync commands at startup
COMMAND_SYNC_MODE=auto

# Feature flags
# Core is required and must stay enabled.
ENABLE_CORE=true
ENABLE_INVITE=false
ENABLE_ORACLES=false

# Oracle / AI support
# Required only when enabling AI-backed oracle/chat behavior.
OPENAI_API_KEY=
EMBEDS_ONLY=true

# Database / persistence placeholders for future phases
DATABASE_URL=
MONGO_URI=

# Role & Channel IDs
SIGNED_ROLE_ID=
ARCHIVE_CATEGORY_ID=
SUMMONING_CHANNEL_ID=
WELCOME_CHANNEL_ID=
BROADCAST_CHANNEL_ID=

# External APIs
WEATHER_API_KEY=
NEWS_API_KEY=
ASTRO_API_KEY=
TZ_API_KEY=
