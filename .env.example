# Core runtime
DISCORD_TOKEN=
CLIENT_ID=
APP_ENV=development
LOG_LEVEL=INFO

# Dedicated home server
# Wilhelmina does not support existing-server takeover/transformation mode.
SERVER_MODE=dedicated
HOME_GUILD_ID=

# Command sync mode:
# - guild: sync only to HOME_GUILD_ID; safest for development and the dedicated server
# - global: sync globally; slower propagation
# - off: do not sync commands at startup
# - auto: guild when HOME_GUILD_ID is set, otherwise global
COMMAND_SYNC_MODE=guild

# SQLite persistence
# Stores guild config and audit logs. Relative paths resolve from the project root.
DATABASE_PATH=data/wilhelmina.sqlite3

# Feature flags
# Core and admin are required and must stay enabled.
ENABLE_CORE=true
ENABLE_ADMIN=true
ENABLE_INVITE=false
ENABLE_ROLL=false
ENABLE_EIGHT_BALL=false
ENABLE_FORTUNE=false

# AI support
# Required only for AI-backed features such as /8ball and /fortune.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=8
AI_MAX_RETRIES=1
